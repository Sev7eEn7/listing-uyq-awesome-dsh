{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-dsh.org/schema/plugin.json",
  "title": "Awesome DSH Registry Entry",
  "type": "object",
  "required": [
    "name",
    "repository",
    "description",
    "type",
    "categories",
    "runtime",
    "official",
    "status",
    "source",
    "verification"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "plugin",
          "agent",
          "skill",
          "tool",
          "sdk",
          "library",
          "integration",
          "template"
        ]
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "dsh"
        ]
      }
    },
    "language": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string"
    },
    "status": {
      "enum": [
        "stable",
        "beta",
        "experimental",
        "community",
        "deprecated",
        "unknown"
      ]
    },
    "official": {
      "type": "boolean"
    },
    "maintained": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    },
    "install": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "source_repository": {
      "type": "string",
      "format": "uri"
    },
    "verification": {
      "type": "object",
      "required": [
        "listed_by_source",
        "repository_url_checked"
      ],
      "properties": {
        "listed_by_source": {
          "type": "boolean"
        },
        "repository_url_checked": {
          "type": "boolean"
        },
        "last_checked": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
